# CNE
persist.vendor.cne.feature=1

# Bluetooth A2DP offload
ro.bluetooth.a2dp_offload.supported=true
persist.bluetooth.a2dp_offload.disabled=false

# Media
media.aac_51_output_enabled=true
media.settings.xml=/vendor/etc/media_profiles_sun.xml
ro.mediaserver.64b.enable=true

# NFC
ro.nfc.port=I2C

# Radio VoNR Calling
persist.radio.is_vonr_enabled_0=true
persist.radio.is_vonr_enabled_1=true

# SSR
persist.vendor.ssr.enable_ramdumps=1

# WiFi display
persist.debug.wfd.enable=1
persist.sys.wfd.virtual=0

# RKPD
remote_provisioning.enable_rkpd=true
remote_provisioning.hostname=remoteprovisioning.googleapis.com

# Camera vendor framework detection
ro.vendor.qti.va_aosp.support=1

# Power/Battery optimizations
pm.sleep_mode=1
ro.sys.fw.bservice_enable=true
ro.sys.fw.bservice_limit=5
ro.sys.fw.bservice_age=5000
ro.sys.fw.bg_apps_limit=24

# WiFi power saving
wifi.supplicant_scan_interval=180
ro.wifi.power.reduction=1

# IMS/VoLTE/VoWiFi override
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1

# IWLAN (WiFi Calling) enablement
persist.dbg.allow_ims_off=0
persist.vendor.data.iwlan.enable=true
persist.data.iwlan.enable=true
persist.vendor.radio.data_con_rprt=1
persist.vendor.radio.is_wfc_enabled=true