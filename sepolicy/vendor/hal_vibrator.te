allow hal_vibrator_default mnt_vendor_file:dir search;
allow hal_vibrator_default mnt_vendor_file:file { getattr open read write };
allow hal_vibrator_default sysfs:dir { open read };
allow hal_vibrator_default sysfs:file { getattr open read write };
allow hal_vibrator_default sysfs_vibrator:dir { open read search };
allow hal_vibrator_default sysfs_vibrator:file { getattr open read write };
allow hal_vibrator_default input_device:chr_file { ioctl open read write };
allow hal_vibrator_default input_device:dir { open read search };
